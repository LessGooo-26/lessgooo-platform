# Copy to .env.local. Never commit credentials. Restart npm run dev / npm start.
# Google Cloud OAuth client: Web application, Drive API enabled.
# Authorized redirect URI for npm start:
# http://127.0.0.1:4173/api/integrations/google/callback
# For npm run dev use port 4174 instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Log in and consent only as lessgooo.ai26@gmail.com.
# Notch Pay merchant dashboard public API key (server-side only).
NOTCHPAY_PUBLIC_KEY=
# Set explicitly to test or live, matching the key in the merchant dashboard.
NOTCHPAY_MODE=test
